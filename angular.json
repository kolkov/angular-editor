{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-editor": {
      "projectType": "library",
      "root": "projects/angular-editor",
      "sourceRoot": "projects/angular-editor/src",
      "prefix": "lib",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/angular-editor/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/angular-editor/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/angular-editor/tsconfig.spec.json",
            "include": [
              "**/*.spec.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/angular-editor/**/*.ts",
              "projects/angular-editor/**/*.html"
            ]
          }
        }
      }
    },
    "angular-editor-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/angular-editor-app",
      "sourceRoot": "projects/angular-editor-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/angular-editor-app/src/main.ts",
            "tsConfig": "projects/angular-editor-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/angular-editor-app/src/assets",
                "output": "assets"
              },
              "projects/angular-editor-app/src/favicon.ico",
              {
                "glob": "**/*",
                "input": "projects/angular-editor/assets/icons/",
                "output": "assets/ae-icons/"
              }
            ],
            "styles": [
              "projects/angular-editor-app/src/styles.scss",
              "projects/angular-editor/themes/default.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular-editor-app:build:production"
            },
            "development": {
              "buildTarget": "angular-editor-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "angular-editor-app:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/angular-editor-app/**/*.ts",
              "projects/angular-editor-app/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
